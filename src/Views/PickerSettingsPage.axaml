<ci:SettingsPageBase xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     x:Class="ClassIsland.RandomPicker.Views.PickerSettingsPage">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">

            <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                       Text="下面这些和悬浮球右键菜单是同一批设置，改哪边都一样。再往下是拍照抽人的详细参数。"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE812;}"
                                       Header="显示悬浮窗"
                                       Description="{Binding PickerVisibleText}">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding PickerVisible, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xEE83;}"
                                       Header="悬浮球大小"
                                       Description="小 / 中 / 大。改完立刻生效。">
                <controls:SettingsExpander.Footer>
                    <ComboBox MinWidth="120" ItemsSource="{Binding SizeNames}"
                              SelectedIndex="{Binding BallSizeIndex, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xF2D5;}"
                                       Header="悬浮球人数显示"
                                       Description="{Binding PickerCountSummary}">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ShowPickerCount, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <Separator Margin="0 12 0 4"/>
            <ci:IconText Glyph="&#xECAB;" Text="抽人" Margin="0 0 0 4"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE13B;}"
                                       Header="抽取来源"
                                       Description="{Binding SourceSummary}">
                <controls:SettingsExpander.Footer>
                    <ComboBox MinWidth="160" ItemsSource="{Binding SourceNames}"
                              SelectedIndex="{Binding SourceIndex, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xEC28;}"
                                       Header="抽取数量"
                                       Description="{Binding CountSummary}">
                <controls:SettingsExpander.Footer>
                    <ComboBox MinWidth="120" ItemsSource="{Binding CountNames}"
                              SelectedIndex="{Binding PickCountIndex, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE125;}"
                                       Header="抽取模式"
                                       Description="{Binding ReplaceSummary}">
                <controls:SettingsExpander.Footer>
                    <ComboBox MinWidth="120" ItemsSource="{Binding ReplaceNames}"
                              SelectedIndex="{Binding ReplaceIndex, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xF26F;}"
                                       Header="分组方式"
                                       Description="{Binding GroupStyleSummary}">
                <controls:SettingsExpander.Footer>
                    <ComboBox MinWidth="120" ItemsSource="{Binding GroupStyleNames}"
                              SelectedIndex="{Binding GroupStyleIndex, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE92F;}"
                                       Header="小组总数"
                                       Description="{Binding GroupSummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="1" Maximum="26" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding GroupCount, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="54"
                                   Text="{Binding GroupCountText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE0B5;}"
                                       Header="重置本轮"
                                       Description="{Binding RoundSummary}">
                <controls:SettingsExpander.Footer>
                    <Button Click="OnResetRound">
                        <ci:IconText Glyph="&#xE0B5;" Text="重置本轮"/>
                    </Button>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <Separator Margin="0 12 0 4"/>
            <ci:IconText Glyph="&#xF483;" Text="结果显示" Margin="0 0 0 4"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8D1;}"
                                       Header="屏幕中央弹出"
                                       Description="抽中之后在屏幕中央亮出大字。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ShowCenterReveal, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE025;}"
                                       Header="ClassIsland 提醒"
                                       Description="同时往 ClassIsland 主界面推一条提醒。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ShowNotification, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xF361;}"
                                       Header="停留时长"
                                       Description="{Binding HoldSummary}">
                <controls:SettingsExpander.Footer>
                    <ComboBox MinWidth="120" ItemsSource="{Binding HoldNames}"
                              SelectedIndex="{Binding HoldIndex, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <Separator Margin="0 12 0 4"/>
            <ci:IconText Glyph="&#xE8A5;" Text="名单" Margin="0 0 0 4"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8A5;}"
                                       Header="选择名单"
                                       Description="{Binding ListSummary}">
                <controls:SettingsExpander.Footer>
                    <ComboBox MinWidth="200" ItemsSource="{Binding ListNames}"
                              SelectedIndex="{Binding ListIndex, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8A5;}"
                                       Header="名单文件"
                                       Description="{Binding RosterSummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnReloadRoster">
                            <ci:IconText Glyph="&#xE161;" Text="重新加载"/>
                        </Button>
                        <Button Click="OnOpenRoster">
                            <ci:IconText Glyph="&#xE8E5;" Text="打开"/>
                        </Button>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <Separator Margin="0 12 0 4"/>
            <ci:IconText Glyph="&#xE722;" Text="拍照抽人" Margin="0 0 0 4"/>

            <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                       Text="⚠ 仅能检测正对镜头的人脸，背对镜头者无法抽中。建议先用「试拍一次」验证效果。"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE722;}"
                                       Header="试拍一次"
                                       Description="{Binding ShotSummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnRefreshCameras">
                            <ci:IconText Glyph="&#xE117;" Text="刷新摄像头"/>
                        </Button>
                        <Button Click="OnTestShot" IsEnabled="{Binding CanShoot}">
                            <ci:IconText Glyph="&#xE722;" Text="试拍一次"/>
                        </Button>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <Border CornerRadius="8" ClipToBounds="True" Margin="0 4 0 0"
                    IsVisible="{Binding HasPreview}">
                <Image Source="{Binding Preview}" MaxHeight="420" Stretch="Uniform"/>
            </Border>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE960;}"
                                       Header="摄像头"
                                       Description="{Binding CameraSummary}">
                <controls:SettingsExpander.Footer>
                    <ComboBox MinWidth="240" ItemsSource="{Binding CameraNames}"
                              SelectedIndex="{Binding CameraIndex, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE916;}"
                                       Header="摄像头保持开启"
                                       Description="{Binding KeepAliveSummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="0" Maximum="600" TickFrequency="10"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding KeepAlive, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="70"
                                   Text="{Binding KeepAliveText}"/>
                        <Button Click="OnCloseCamera">
                            <ci:IconText Glyph="&#xE711;" Text="立刻关闭"/>
                        </Button>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE71E;}"
                                       Header="检测阈值"
                                       Description="调低可检测到更多人，也更易误检。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="0.05" Maximum="0.95" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding Threshold, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="54"
                                   Text="{Binding ThresholdText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8B9;}"
                                       Header="分块检测"
                                       Description="人多且距离远时可检测到更多，速度变慢。一般无需开启。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding UseTiled, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE80A;}"
                                       Header="分块数量"
                                       Description="仅在开启分块检测时生效。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="2" Maximum="4" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding TileGrid, Mode=TwoWay}"
                                IsEnabled="{Binding UseTiled}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="54"
                                   Text="{Binding TileGridText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE0BE;}"
                                       Header="回避刚抽过的人"
                                       Description="按人脸在画面里的位置认人。设成不回避就是每次独立随机，容易连抽到同一个。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="0" Maximum="20" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding AvoidRecent, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="66"
                                   Text="{Binding AvoidRecentText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xF2ED;}"
                                       Header="混入文字抽选"
                                       Description="拍照模式下有多大概率改成抽名字。也照顾到没被拍进画面的人。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="0" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding TextChance, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="66"
                                   Text="{Binding TextChanceText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE699;}"
                                       Header="文字抽选用单独名单"
                                       Description="开启后读同一序号旁边的「listN-文字.txt」，和主名单互不影响。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding SeparateTextRoster, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE7A8;}"
                                       Header="裁切范围"
                                       Description="相对人脸框的放大倍数。纵向留出头肩。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Text="横"/>
                        <Slider Width="110" Minimum="1.0" Maximum="4.0" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding CropWidth, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="纵"/>
                        <Slider Width="110" Minimum="1.0" Maximum="5.0" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding CropHeight, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="86"
                                   Text="{Binding CropText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE74E;}"
                                       Header="保存原始照片"
                                       Description="默认关闭。不保存时照片仅在内存中处理。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding SavePhotos, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
