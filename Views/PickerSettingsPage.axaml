<ci:SettingsPageBase xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     x:Class="ClassIsland.RandomPicker.Views.PickerSettingsPage">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">

            <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                       Text="日常操作在悬浮窗右键菜单。此页配置多份名单、小组抽选、名单权重、URL 抽人、自动化与拍照抽人。"/>

            <Separator Margin="0 12 0 4"/>
            <ci:IconText Glyph="&#xE80F;" Text="常规" Margin="0 0 0 4"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE80F;}"
                                       Header="显示悬浮窗"
                                       Description="{Binding FloatingWindowSummary}">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding FloatingWindowVisible, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE7A8;}"
                                       Header="悬浮窗缩放系数"
                                       Description="调整悬浮窗大小，以适配不同的屏幕。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="0.5" Maximum="2.0" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding FloatingScale, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="54"
                                   Text="{Binding FloatingScaleText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE7EE;}"
                                       Header="下课禁用"
                                       Description="在课间禁用所有点名功能。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding DisableDuringBreak, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE918;}"
                                       Header="打断点名"
                                       Description="打断上一次点名，并触发新的点名。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding InterruptPreviousPick, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE7EB;}"
                                       Header="快捷键切换悬浮窗"
                                       Description="{Binding HotkeySummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ComboBox MinWidth="130" ItemsSource="{Binding HotkeyModifierChoices}"
                                  SelectedIndex="{Binding HotkeyModifiersIndex, Mode=TwoWay}"/>
                        <ComboBox MinWidth="90" ItemsSource="{Binding HotkeyKeyChoices}"
                                  SelectedIndex="{Binding HotkeyKeyIndex, Mode=TwoWay}"/>
                        <ToggleSwitch IsChecked="{Binding HotkeyEnabled, Mode=TwoWay}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <Separator Margin="0 12 0 4"/>
            <ci:IconText Glyph="&#xE8A5;" Text="名单" Margin="0 0 0 4"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8A5;}"
                                       Header="当前名单"
                                       Description="{Binding RosterSummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ComboBox MinWidth="180" ItemsSource="{Binding RosterChoices}"
                                  SelectedIndex="{Binding RosterIndex, Mode=TwoWay}"/>
                        <Button Click="OnOpenRoster">
                            <ci:IconText Glyph="&#xE8E5;" Text="打开"/>
                        </Button>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
                <TextBlock Classes="l-instructive" TextWrapping="Wrap" Margin="0 8 0 4"
                           Text="共五份名单，共用一套权重设置。切换后圆钮计数、抽组结果和权重行都会跟着换。1 号就是原来的「名单.txt」，2~5 号第一次切换时会自动建好示例文件。"/>
            </controls:SettingsExpander>

            <Separator Margin="0 12 0 4"/>
            <ci:IconText Glyph="&#xE902;" Text="小组抽选" Margin="0 0 0 4"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE902;}"
                                       Header="每组人数"
                                       Description="{Binding GroupSummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="1" Maximum="20" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding GroupSize, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="54"
                                   Text="{Binding GroupSize}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
                <TextBlock Classes="l-instructive" TextWrapping="Wrap" Margin="0 8 0 4"
                           Text="按名单顺序切组，最后一组人数不足也照样成组。小组有独立轮次，抽完自动开新一轮。在悬浮窗右键菜单里选「小组抽选」即可使用，大字会分行显示组名和组员。"/>
            </controls:SettingsExpander>

            <Separator Margin="0 12 0 4"/>
            <ci:IconText Glyph="&#xE722;" Text="拍照抽人" Margin="0 0 0 4"/>

            <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                       Text="⚠ 仅能检测正对镜头的人脸，背对镜头者无法抽中。建议先用「试拍一次」验证效果。"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE722;}"
                                       Header="试拍一次"
                                       Description="{Binding ShotSummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnRefreshCameras">
                            <ci:IconText Glyph="&#xE117;" Text="刷新摄像头"/>
                        </Button>
                        <Button Click="OnTestShot" IsEnabled="{Binding CanShoot}">
                            <ci:IconText Glyph="&#xE722;" Text="试拍一次"/>
                        </Button>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <Border CornerRadius="8" ClipToBounds="True" Margin="0 4 0 0"
                    IsVisible="{Binding HasPreview}">
                <Image Source="{Binding Preview}" MaxHeight="420" Stretch="Uniform"/>
            </Border>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE960;}"
                                       Header="摄像头"
                                       Description="{Binding CameraSummary}">
                <controls:SettingsExpander.Footer>
                    <ComboBox MinWidth="240" ItemsSource="{Binding CameraNames}"
                              SelectedIndex="{Binding CameraIndex, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE916;}"
                                       Header="摄像头保持开启"
                                       Description="{Binding KeepAliveSummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="0" Maximum="600" TickFrequency="10"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding KeepAlive, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="70"
                                   Text="{Binding KeepAliveText}"/>
                        <Button Click="OnCloseCamera">
                            <ci:IconText Glyph="&#xE711;" Text="立刻关闭"/>
                        </Button>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE71E;}"
                                       Header="检测阈值"
                                       Description="调低可检测到更多人，也更易误检。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="0.05" Maximum="0.95" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding Threshold, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="54"
                                   Text="{Binding ThresholdText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8B9;}"
                                       Header="分块检测"
                                       Description="人多且距离远时可检测到更多，速度变慢。一般无需开启。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding UseTiled, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE80A;}"
                                       Header="分块数量"
                                       Description="仅在开启分块检测时生效。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="2" Maximum="4" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding TileGrid, Mode=TwoWay}"
                                IsEnabled="{Binding UseTiled}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="54"
                                   Text="{Binding TileGridText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE0BE;}"
                                       Header="回避刚抽过的人"
                                       Description="按人脸在画面里的位置认人。设成不回避就是每次独立随机，容易连抽到同一个。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="0" Maximum="20" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding AvoidRecent, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="66"
                                   Text="{Binding AvoidRecentText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xF2ED;}"
                                       Header="混入文字抽选"
                                       Description="拍照模式下有多大概率改成抽名字。也照顾到没被拍进画面的人。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="0" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding TextChance, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="66"
                                   Text="{Binding TextChanceText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE699;}"
                                       Header="文字抽选用单独名单"
                                       Description="开启后读插件配置目录下的「名单-文字.txt」，和主名单互不影响。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding SeparateTextRoster, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE7A8;}"
                                       Header="裁切范围"
                                       Description="相对人脸框的放大倍数。纵向留出头肩。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Text="横"/>
                        <Slider Width="110" Minimum="1.0" Maximum="4.0" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding CropWidth, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="纵"/>
                        <Slider Width="110" Minimum="1.0" Maximum="5.0" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding CropHeight, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="86"
                                   Text="{Binding CropText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE74E;}"
                                       Header="保存原始照片"
                                       Description="默认关闭。不保存时照片仅在内存中处理。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding SavePhotos, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <Separator Margin="0 16 0 4"/>
            <ci:IconText Glyph="&#xE8D5;" Text="名单权重" Margin="0 0 0 4"/>

            <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                       Text="权重越大越容易被抽中。名单文件里写「张三 *3」也能加权；这里填的值优先。留空即恢复名单里写的权重，关掉总开关则所有人等概率。"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8D5;}"
                                       Header="启用权重"
                                       Description="关掉后所有名字等概率，名单里的 *N 也暂时不生效。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding EnableNameWeights, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8A5;}"
                                       Header="逐个设置权重"
                                       Description="{Binding WeightSummary}"
                                       IsExpanded="True">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnRefreshWeights">
                            <ci:IconText Glyph="&#xE117;" Text="刷新名单"/>
                        </Button>
                        <Button Click="OnResetWeights">
                            <ci:IconText Glyph="&#xE711;" Text="全部重置"/>
                        </Button>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
                <ItemsControl ItemsSource="{Binding WeightRows}" Margin="0 8 0 4" MinWidth="480">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="30,*,170,64,Auto" Margin="0 3"
                                  VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="{Binding Index}"
                                           VerticalAlignment="Center" Opacity="0.6"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           VerticalAlignment="Center" Margin="6 0 8 0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Name}"/>
                                <Slider Grid.Column="2" Minimum="0.1" Maximum="10.0"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        Value="{Binding WeightValue, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="3" Text="{Binding WeightText}"
                                           VerticalAlignment="Center" Margin="6 0 0 0"
                                           FontSize="12" Opacity="0.85"/>
                                <Button Grid.Column="4" Margin="6 0 0 0" Padding="4"
                                        VerticalAlignment="Center" Click="OnResetRowWeight"
                                        Tag="{Binding}"
                                        ToolTip.Tip="恢复名单里写的权重">
                                    <ci:IconText Glyph="&#xE9A2;" Text=""/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:SettingsExpander>

            <Separator Margin="0 16 0 4"/>
            <ci:IconText Glyph="&#xE774;" Text="通过 URL 抽人" Margin="0 0 0 4"/>

            <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                       Text="两种 URL：classisland:// 走 ClassIsland 自带的协议，适合快捷方式和自动化；本地 HTTP 接口适合浏览器或脚本，默认关闭且只监听本机。两种方式都支持名单抽人、抽小组、拍照抽人和一次抽多人。"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE774;}"
                                       Header="允许 classisland:// 链接抽人"
                                       Description="{Binding UriSummary}">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding EnableUriPick, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8A5;}"
                                       Header="示例链接"
                                       Description="复制到浏览器地址栏、快捷方式或运行窗口即可调用。"
                                       IsExpanded="True">
                <TextBlock Text="{Binding UriExamples}" TextWrapping="Wrap" Margin="0 8 0 4"
                           FontSize="12" Opacity="0.85"/>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE968;}"
                                       Header="本地 HTTP 接口"
                                       Description="{Binding HttpStatus}">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding EnableHttpApi, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8AC;}"
                                       Header="端口与令牌"
                                       Description="端口范围 1024~65535。令牌留空表示不校验；改完点「应用」。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBox Width="90" Text="{Binding HttpApiPortText, Mode=TwoWay}"
                                 VerticalAlignment="Center"/>
                        <TextBox Width="170" Watermark="令牌（可留空）"
                                 Text="{Binding HttpApiTokenText, Mode=TwoWay}"
                                 VerticalAlignment="Center"/>
                        <Button Click="OnRestartHttp">
                            <ci:IconText Glyph="&#xE117;" Text="应用"/>
                        </Button>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
                <TextBlock Text="{Binding HttpExamples}" TextWrapping="Wrap" Margin="0 8 0 4"
                           FontSize="12" Opacity="0.85"/>
            </controls:SettingsExpander>

            <Separator Margin="0 16 0 4"/>
            <ci:IconText Glyph="&#xE9E9;" Text="自动化与规则集" Margin="0 0 0 4"/>

            <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                       Text="{Binding AutomationSummary}"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE9E9;}"
                                       Header="添加示例规则集"
                                       Description="往当前自动化配置里加一条「触发器 + 规则集 + 行动」的示例工作流，默认不启用，改好再打开。">
                <controls:SettingsExpander.Footer>
                    <Button Click="OnAddSampleWorkflow">
                        <ci:IconText Glyph="&#xE710;" Text="添加示例"/>
                    </Button>
                </controls:SettingsExpander.Footer>
                <TextBlock Text="{Binding SampleSummary}" TextWrapping="Wrap" Margin="0 8 0 4"
                           FontSize="12" Opacity="0.85"/>
            </controls:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
